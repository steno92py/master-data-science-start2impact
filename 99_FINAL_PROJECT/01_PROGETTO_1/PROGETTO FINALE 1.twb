      <aliases enabled='yes' />
      <column caption='Country Name' datatype='string' name='[Calculation_1988057818842476544]' role='dimension' semantic-role='[State].[Name]' type='nominal'>
        <calculation class='tableau' formula='// Country (name)&#13;&#10;CASE LOWER([country])&#13;&#10; WHEN &quot;it&quot; THEN &quot;Italy&quot;&#13;&#10; WHEN &quot;fr&quot; THEN &quot;France&quot;&#13;&#10; WHEN &quot;uk&quot; THEN &quot;United Kingdom&quot;&#13;&#10;END' />
      </column>
      <column caption='Number of Records' datatype='integer' default-format='N' name='[Calculation_1988057818845057025]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1' />
      </column>
      <column caption='Utenti Unici' datatype='integer' name='[Calculation_1988057818846822402]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Utenti unici&#13;&#10;COUNTD([user_uuid])' />
      </column>
      <column caption='Avg Stelle' datatype='real' name='[Calculation_1988057818847662083]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([stars])' />
      </column>
      <column caption='% Weekend' datatype='real' default-format='p0%' name='[Calculation_1988057818848530436]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// % Weekend&#13;&#10;AVG( INT([is_weekend]) )' />
      </column>
      <column caption='Misura selezionata' datatype='real' name='[Calculation_1988057818851065861]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parametro 1]&#13;&#10; WHEN &quot;Visite&quot; THEN [Calculation_1988057818845057025]&#13;&#10; WHEN &quot;Utenti&quot; THEN COUNTD([user_uuid])&#13;&#10; WHEN &quot;Avg Stelle&quot; THEN AVG([stars])&#13;&#10; WHEN &quot;%Weekend&quot; THEN AVG(INT([is_weekend]))&#13;&#10;END' />
      </column>
      <column caption='Data di Visita' datatype='datetime' name='[Calculation_1988057818853851142]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATETRUNC(&apos;month&apos;,[visit_date])' />
      </column>
