    {
      "name": "Solo Stefano",
      "id": "accesso-chat",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -80,
        300
      ],
      "parameters": {
        "jsCode": "// Sostituisci con il tuo ID numerico della chat privata Telegram.\nconst ALLOWED_CHAT_ID = 'INSERISCI_CHAT_ID';\nif (!/^\\d+$/.test(ALLOWED_CHAT_ID)) {\n  throw new Error('Configura ALLOWED_CHAT_ID nel nodo Solo Stefano.');\n}\nreturn $input.all().filter(item =>\n  item.json.message?.chat?.type === 'private' &&\n  String(item.json.message.chat.id) === ALLOWED_CHAT_ID\n);"
      }
    },
    {
      "name": "Normalizza input",
      "id": "normalizza-input",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        200
      ],
      "parameters": {
        "jsCode": "const item = $input.first();\nconst message = $('Telegram Trigger').first().json.message;\nconst text = item.json.message?.text ?? item.json.text;\nif (typeof text !== 'string' || !text.trim()) {\n  throw new Error('Messaggio o trascrizione vuoti.');\n}\nif (text.length > 12000) throw new Error('Messaggio troppo lungo: massimo 12000 caratteri.');\nreturn [{json: {input_text: text.trim(), chat_id: String(message.chat.id)}, pairedItem: {item: 0}}];\n"
      }
    },
    {
      "name": "Formato non supportato",
      "id": "unsupported",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
