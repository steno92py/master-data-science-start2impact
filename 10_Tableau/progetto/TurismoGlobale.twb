          <datasource-dependencies datasource='Parameters'>
            <column caption='Metric Selector Generale' datatype='string' name='[Metric Selector Ingressi (copia)_1726849021761310733]' param-domain-type='list' role='measure' type='nominal' value='&quot;Arrivi nello Stato&quot;'>
              <calculation class='tableau' formula='&quot;Arrivi nello Stato&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0mw61p10tps31c12be6f41gadslf'>
            <column caption='Arrivi nello Stato' datatype='integer' datatype-customized='true' default-format='*#,##0 M' name='[Arrivals]' role='dimension' type='ordinal' />
            <column aggregation='Sum' caption='Spesa media procapite in entrata' datatype='real' datatype-customized='true' default-format='*$#,##0' name='[Calculation_495114523264069639]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='[ReceiptsUSD] / NULLIF([Arrivals], 0)' />
            </column>
            <column datatype='string' name='[Country Name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Partenze dallo Stato' datatype='integer' datatype-customized='true' default-format='*#,##0 M' name='[Departures]' role='dimension' type='ordinal' />
            <column caption='Metrica scelta' datatype='real' name='[Metriche Ingressi (copia)_1726849021760659468]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Metric Selector Ingressi (copia)_1726849021761310733]&#13;&#10;WHEN &quot;Arrivi nello Stato&quot;      THEN [Arrivals]&#13;&#10;WHEN &quot;Partenze dallo Stato&quot;    THEN [Departures]&#13;&#10;WHEN &quot;Entrate Turismo Internazionale (Trasporti Inclusi)&quot;  THEN [ReceiptsUSD]&#13;&#10;WHEN &quot;Uscite Turismo Internazionale (Trasporti Inclusi)&quot;     THEN [SpendUSD]&#13;&#10;WHEN &quot;Spesa media procapite in entrata&quot; THEN [Calculation_495114523264069639] &#13;&#10;WHEN &quot;Spesa media procapite in uscita&quot; THEN [spesa media del turista che VISITA il Paese (copia)_1726849021716553733]&#13;&#10;WHEN &quot;Ricavi di Trasporto&quot; THEN ([TrnR]) / 1e9          // miliardi&#13;&#10;WHEN &quot;Spese di Trasporto&quot; THEN ([TrnX]) / 1e9&#13;&#10;END' />
            </column>
            <column caption='Entrate Turismo Internazionale (Trasporti Inclusi)' datatype='real' datatype-customized='true' default-format='C1033%' name='[ReceiptsUSD]' role='dimension' type='ordinal' />
            <column caption='Uscite Turismo Internazionale (Trasporti Inclusi)' datatype='real' datatype-customized='true' name='[SpendUSD]' role='dimension' type='quantitative' />
            <column aggregation='Sum' caption='Ricavi di Trasporto' datatype='real' datatype-customized='true' default-format='e0.00e+00' name='[TrnR]' role='dimension' semantic-role='' type='ordinal' />
            <column caption='Spese di Trasporto' datatype='real' datatype-customized='true' name='[TrnX]' role='dimension' type='ordinal' />
            <column aggregation='Sum' datatype='integer' name='[Year]' role='dimension' type='ordinal' />
            <column-instance column='[Country Name]' derivation='None' name='[none:Country Name:nk]' pivot='key' type='nominal' />
            <column-instance column='[Metriche Ingressi (copia)_1726849021760659468]' derivation='None' name='[none:Metriche Ingressi (copia)_1726849021760659468:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Year]' derivation='None' name='[none:Year:ok]' pivot='key' type='ordinal' />
            <column aggregation='Sum' caption='Spesa media procapite in uscita' datatype='real' datatype-customized='true' default-format='*$#,##0' name='[spesa media del turista che VISITA il Paese (copia)_1726849021716553733]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='[SpendUSD] / NULLIF([Departures], 0)' />
            </column>
