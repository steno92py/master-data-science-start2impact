      <aliases enabled='yes' />
      <column caption='Arrivi nello Stato' datatype='integer' datatype-customized='true' default-format='*#,##0 M' name='[Arrivals]' role='dimension' type='ordinal' />
      <column caption='Δ % YoY' datatype='real' name='[Calculation_1127025846614241281]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([Arrivals]) - LOOKUP(SUM([Arrivals]),-1)) / ABS(LOOKUP(SUM([Arrivals]),-1))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Tot. Spesa media procapite' datatype='real' name='[Calculation_1523342613933522947]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [Year] : SUM([Calculation_495114523264069639]) }' />
      </column>
      <column aggregation='Sum' caption='Spese per Visitatore' datatype='real' default-format='C1033%' name='[Calculation_1726849021744009222]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='// Spesa media per visitatore internazionale&#13;&#10;// FIXED preserva la granularità Paese-Anno anche se filtri altro&#13;&#10;IFNULL(&#13;&#10;    { FIXED [Country Name], [Year] : SUM([TvlR]) }&#13;&#10;    /&#13;&#10;    NULLIF({ FIXED [Country Name], [Year] : SUM([Arrivals]) }, 0)&#13;&#10;, 0)' />
      </column>
      <column caption='Totale Arrivi' datatype='integer' name='[Calculation_1726849021746499591]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='{ FIXED [Year] : SUM([Arrivals]) }' />
      </column>
      <column aggregation='Sum' caption='Spesa media procapite in entrata' datatype='real' datatype-customized='true' default-format='*$#,##0' name='[Calculation_495114523264069639]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='[ReceiptsUSD] / NULLIF([Arrivals], 0)' />
      </column>
      <column caption='Arrivi' datatype='integer' default-format='*#,##0 M' name='[Calculation_975310834493362176]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Mostra Arrivi per alcune metriche, Partenze per altre&#13;&#10;IF      [Parameters].[Metric Selector Ingressi (copia)_1726849021761310733] IN (&quot;Arrivi&quot;,&#13;&#10;&quot;Ricavi di Trasporto&quot;, &#13;&#10;&quot;Entrate Turismo Internazionale (Trasporti Inclusi)&quot;,&#13;&#10;&quot;Spesa media procapite in entrata&quot;&#13;&#10;) THEN ([Arrivals])&#13;&#10;END' />
      </column>
      <column caption='Metrica Sec' datatype='integer' name='[Calculation_975310834505830403]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Mostra Arrivi per alcune metriche, Partenze per altre&#13;&#10;IF      [Parameters].[Metric Selector Ingressi (copia)_1726849021761310733] IN (&quot;Arrivi&quot;,&#13;&#10;&quot;Ricavi di Trasporto&quot;, &#13;&#10;&quot;Entrate Turismo Internazionale (Trasporti Inclusi)&quot;,&#13;&#10;&quot;Spesa media procapite in entrata&quot;&#13;&#10;) THEN ([Arrivals])&#13;&#10;ELSEIF  [Parameters].[Metric Selector Ingressi (copia)_1726849021761310733] IN (&quot;Partenze&quot;,&#13;&#10;&quot;Spese di Trasporto&quot;, &#13;&#10;&quot;Uscite Turismo Internazionale (Trasporti Inclusi)&quot;,&#13;&#10;&quot;Spesa media procapite in uscita&quot;)   THEN ([Departures])&#13;&#10;ELSE    NULL  // per le metriche dove non vuoi la colonna extra&#13;&#10;END' />
      </column>
      <column datatype='string' name='[Country Code]' role='dimension' semantic-role='[Country].[Name]' type='nominal' />
      <column datatype='string' name='[Country Name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
      <column caption='Partenze dallo Stato' datatype='integer' datatype-customized='true' default-format='*#,##0 M' name='[Departures]' role='dimension' type='ordinal' />
      <column caption='Partenze' datatype='integer' default-format='*#,##0 M' name='[Metrica Secondaria (copia)_975310834504159234]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Mostra Arrivi per alcune metriche, Partenze per altre&#13;&#10;IF [Parameters].[Metric Selector Ingressi (copia)_1726849021761310733] IN (&quot;Partenze&quot;,&#13;&#10;&quot;Spese di Trasporto&quot;, &#13;&#10;&quot;Uscite Turismo Internazionale (Trasporti Inclusi)&quot;,&#13;&#10;&quot;Spesa media procapite in uscita&quot;)   THEN ([Departures])&#13;&#10;ELSE    NULL  // per le metriche dove non vuoi la colonna extra&#13;&#10;END' />
      </column>
      <column caption='Metriche Generali' datatype='real' name='[Metriche Ingressi (copia)_1726849021760659468]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Metric Selector Ingressi (copia)_1726849021761310733]&#13;&#10;WHEN &quot;Arrivi nello Stato&quot;      THEN [Arrivals]&#13;&#10;WHEN &quot;Partenze dallo Stato&quot;    THEN [Departures]&#13;&#10;WHEN &quot;Entrate Turismo Internazionale (Trasporti Inclusi)&quot;  THEN [ReceiptsUSD]&#13;&#10;WHEN &quot;Uscite Turismo Internazionale (Trasporti Inclusi)&quot;     THEN [SpendUSD]&#13;&#10;WHEN &quot;Spesa media procapite in entrata&quot; THEN [Calculation_495114523264069639] &#13;&#10;WHEN &quot;Spesa media procapite in uscita&quot; THEN [spesa media del turista che VISITA il Paese (copia)_1726849021716553733]&#13;&#10;WHEN &quot;Ricavi di Trasporto&quot; THEN ([TrnR]) / 1e9          // miliardi&#13;&#10;WHEN &quot;Spese di Trasporto&quot; THEN ([TrnX]) / 1e9&#13;&#10;WHEN &quot;Spese per Visitatore&quot; THEN [Calculation_1726849021744009222]&#13;&#10;END' />
      </column>
      <column caption='Receipts EXP' datatype='real' datatype-customized='true' name='[ReceiptsEXP]' role='dimension' type='ordinal' />
      <column caption='Entrate Turismo Internazionale (Trasporti Inclusi)' datatype='real' datatype-customized='true' default-format='C1033%' name='[ReceiptsUSD]' role='dimension' type='ordinal' />
      <column caption='Spend EXP' datatype='real' datatype-customized='true' name='[SpendEXP]' role='dimension' type='ordinal' />
      <column caption='Uscite Turismo Internazionale (Trasporti Inclusi)' datatype='real' datatype-customized='true' name='[SpendUSD]' role='dimension' type='quantitative' />
      <column caption='Totale Ricavi Trasporto' datatype='real' default-format='c#,##0.00&quot; mld €&quot;;-#,##0.00&quot; mld €&quot;' name='[Totale Arrivi (copia)_1523342613925441536]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='{ FIXED [Year] : SUM([TrnR]) } / 1e9' />
      </column>
      <column caption='Totale Partenze' datatype='integer' name='[Totale Arrivi (copia)_1726849021755609097]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='SUM([Departures])' />
      </column>
      <column caption='Totale Entrate Turismo internazionale (Trasporti Inclusi)' datatype='real' default-format='c#,##0.00&quot; mld €&quot;;-#,##0.00&quot; mld €&quot;' name='[Totale Entrate Turismo internazionale (copia)_1523342613927546882]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='{ FIXED [Year] : SUM([ReceiptsUSD]) } / 1e9' />
      </column>
      <column aggregation='Sum' caption='Ricavi di Trasporto' datatype='real' datatype-customized='true' default-format='e0.00e+00' name='[TrnR]' role='dimension' semantic-role='' type='ordinal' />
      <column caption='Spese di Trasporto' datatype='real' datatype-customized='true' name='[TrnX]' role='dimension' type='ordinal' />
      <column caption='Entrate Turismo Internazionale' datatype='real' datatype-customized='true' name='[TvlR]' role='dimension' type='quantitative' />
      <column aggregation='Sum' datatype='integer' name='[Year]' role='dimension' type='ordinal' />
      <column caption='tourism_2005_2019.csv' datatype='table' name='[__tableau_internal_object_id__].[tourism_2005_2019.csv_18645D904DC1422BAB2FBC0622CB43CA]' role='measure' type='quantitative' />
      <column aggregation='Sum' caption='Spesa media procapite in uscita' datatype='real' datatype-customized='true' default-format='*$#,##0' name='[spesa media del turista che VISITA il Paese (copia)_1726849021716553733]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='[SpendUSD] / NULLIF([Departures], 0)' />
      </column>
