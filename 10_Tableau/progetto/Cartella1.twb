      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#4e79a7' fontsize='10'>Heatmap &lt;</run>
            <run bold='true' fontalignment='1' fontcolor='#4e79a7' fontsize='10'>[Parameters].[Metric Selector Ingressi (copia)_1726849021761310733]</run>
            <run bold='true' fontalignment='1' fontcolor='#4e79a7' fontsize='10'>&gt; - &lt;</run>
            <run bold='true' fontalignment='1' fontcolor='#4e79a7' fontsize='10'>[federated.0mw61p10tps31c12be6f41gadslf].[none:Year:ok]</run>
            <run bold='true' fontalignment='1' fontcolor='#4e79a7' fontsize='10'>&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='tourism_2005_2019' name='federated.0mw61p10tps31c12be6f41gadslf' />
            <datasource caption='Parametri' name='Parameters' />
          </datasources>
          <mapsources>
            <mapsource name='Tableau' />
          </mapsources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Metric Selector Generale' datatype='string' name='[Metric Selector Ingressi (copia)_1726849021761310733]' param-domain-type='list' role='measure' type='nominal' value='&quot;Arrivi nello Stato&quot;'>
              <calculation class='tableau' formula='&quot;Arrivi nello Stato&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0mw61p10tps31c12be6f41gadslf'>
            <column caption='Arrivi nello Stato' datatype='integer' datatype-customized='true' default-format='*#,##0 M' name='[Arrivals]' role='dimension' type='ordinal' />
            <column aggregation='Sum' caption='Spese per Visitatore' datatype='real' default-format='C1033%' name='[Calculation_1726849021744009222]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='// Spesa media per visitatore internazionale&#13;&#10;// FIXED preserva la granularità Paese-Anno anche se filtri altro&#13;&#10;IFNULL(&#13;&#10;    { FIXED [Country Name], [Year] : SUM([TvlR]) }&#13;&#10;    /&#13;&#10;    NULLIF({ FIXED [Country Name], [Year] : SUM([Arrivals]) }, 0)&#13;&#10;, 0)' />
            </column>
            <column aggregation='Sum' caption='Spesa media procapite in entrata' datatype='real' datatype-customized='true' default-format='*$#,##0' name='[Calculation_495114523264069639]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='[ReceiptsUSD] / NULLIF([Arrivals], 0)' />
            </column>
            <column datatype='string' name='[Country Name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Partenze dallo Stato' datatype='integer' datatype-customized='true' default-format='*#,##0 M' name='[Departures]' role='dimension' type='ordinal' />
            <column caption='Metriche Generali' datatype='real' name='[Metriche Ingressi (copia)_1726849021760659468]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Metric Selector Ingressi (copia)_1726849021761310733]&#13;&#10;WHEN &quot;Arrivi nello Stato&quot;      THEN [Arrivals]&#13;&#10;WHEN &quot;Partenze dallo Stato&quot;    THEN [Departures]&#13;&#10;WHEN &quot;Entrate Turismo Internazionale (Trasporti Inclusi)&quot;  THEN [ReceiptsUSD]&#13;&#10;WHEN &quot;Uscite Turismo Internazionale (Trasporti Inclusi)&quot;     THEN [SpendUSD]&#13;&#10;WHEN &quot;Spesa media procapite in entrata&quot; THEN [Calculation_495114523264069639] &#13;&#10;WHEN &quot;Spesa media procapite in uscita&quot; THEN [spesa media del turista che VISITA il Paese (copia)_1726849021716553733]&#13;&#10;WHEN &quot;Ricavi di Trasporto&quot; THEN ([TrnR]) / 1e9          // miliardi&#13;&#10;WHEN &quot;Spese di Trasporto&quot; THEN ([TrnX]) / 1e9&#13;&#10;WHEN &quot;Spese per Visitatore&quot; THEN [Calculation_1726849021744009222]&#13;&#10;END' />
            </column>
            <column caption='Entrate Turismo Internazionale (Trasporti Inclusi)' datatype='real' datatype-customized='true' default-format='C1033%' name='[ReceiptsUSD]' role='dimension' type='ordinal' />
            <column caption='Uscite Turismo Internazionale (Trasporti Inclusi)' datatype='real' datatype-customized='true' name='[SpendUSD]' role='dimension' type='quantitative' />
