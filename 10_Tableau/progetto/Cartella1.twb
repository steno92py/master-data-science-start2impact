            <column aggregation='Sum' caption='Spese per Visitatore' datatype='real' default-format='C1033%' name='[Calculation_1726849021744009222]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='// Spesa media per visitatore internazionale&#13;&#10;// FIXED preserva la granularità Paese-Anno anche se filtri altro&#13;&#10;IFNULL(&#13;&#10;    { FIXED [Country Name], [Year] : SUM([TvlR]) }&#13;&#10;    /&#13;&#10;    NULLIF({ FIXED [Country Name], [Year] : SUM([Arrivals]) }, 0)&#13;&#10;, 0)' />
