            </column>
            <column caption='Entrate Turismo Internazionale (Trasporti Inclusi)' datatype='real' datatype-customized='true' default-format='C1033%' name='[ReceiptsUSD]' role='dimension' type='ordinal' />
            <column caption='Uscite Turismo Internazionale (Trasporti Inclusi)' datatype='real' datatype-customized='true' name='[SpendUSD]' role='dimension' type='quantitative' />
